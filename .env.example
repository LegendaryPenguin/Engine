# Copy to `.env` (which is gitignored) and fill in.
# Only needed for `provider: alpaca`. The yfinance path needs no credentials.
#
# Paper-trading keys are sufficient: the pipeline only reads market data and
# never places an order. Generate them at https://app.alpaca.markets/paper/dashboard/overview

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional. Leave unset to let the account decide — a paid account resolves
# to the full SIP tape, and hard-coding `iex` would silently downgrade it.
# ALPACA_DATA_FEED=iex
